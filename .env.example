# Required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Optional contact-message email delivery. Without these, submissions remain in
# contact_messages with email_status=pending for platform-owner follow-up.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0
# Roll out only after the stock command migration and isolated verification.
# The database switch track_private.stock_command_settings.enabled also defaults off.
NEXT_PUBLIC_ATOMIC_CHECKOUT_ENABLED=false
NEXT_PUBLIC_STOCK_INTAKE_ENABLED=false

# Zainpay — use test credentials locally; use live credentials only in
# the production environment. Credentials prefixed by the selected mode
# are isolated from the other mode. Legacy unprefixed credentials are
# supported when no mode-prefixed credentials are configured.
ZAINPAY_MODE=test
ZAINPAY_TEST_BASE_URL=https://sandbox.zainpay.ng
ZAINPAY_LIVE_BASE_URL=https://api.zainpay.ng
ZAINPAY_TEST_PUBLIC_KEY=
ZAINPAY_TEST_PRIVATE_KEY=
ZAINPAY_TEST_DEFAULT_ZAINBOX=
ZAINPAY_TEST_WEBHOOK_SECRET=
ZAINPAY_TEST_SECRET_KEY=
ZAINPAY_TEST_ZAINBOX_CODE=
ZAINPAY_LIVE_PUBLIC_KEY=
ZAINPAY_LIVE_PRIVATE_KEY=
ZAINPAY_LIVE_DEFAULT_ZAINBOX=
ZAINPAY_LIVE_WEBHOOK_SECRET=
ZAINPAY_LIVE_SECRET_KEY=
ZAINPAY_LIVE_ZAINBOX_CODE=

# Legacy single-mode credentials (used only when no mode-prefixed
# credentials are configured). Keep these matched to ZAINPAY_MODE.
ZAINPAY_PUBLIC_KEY=
ZAINPAY_PRIVATE_KEY=
ZAINPAY_BASE_URL=https://sandbox.zainpay.ng
ZAINPAY_DEFAULT_ZAINBOX=
ZAINPAY_WEBHOOK_SECRET=
ZAINPAY_SECRET_KEY=
ZAINPAY_ZAINBOX_CODE=

# Optional update metadata
TracKasuwa_WINDOWS_LATEST_VERSION=1.0.0
TracKasuwa_WINDOWS_DOWNLOAD_URL=
TracKasuwa_ANDROID_LATEST_VERSION=1.0.0
TracKasuwa_ANDROID_DOWNLOAD_URL=
TracKasuwa_ANDROID_UNKNOWN_SOURCES_HELP_URL=

# Optional debug
NODE_ENV=production

# Server-only OpenAI. Add the key in Vercel and redeploy. Never use NEXT_PUBLIC_ for it.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_API_KEY=
AI_EMAIL_URL=
AI_EMAIL_KEY=
AI_SMS_URL=
AI_SMS_KEY=

# Direct public GitHub Release asset URLs (e.g. /releases/download/<tag>/<file.apk|file.exe>).
# The app checks the asset before enabling the link; missing/unreachable files show "Coming soon".
# The URLs must end in .apk and .exe respectively. Blank disables that button.
# Override legacy TracKasuwa_*_DOWNLOAD_URL variables.
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_WINDOWS_EXE_URL=
# Optional actual asset sizes, e.g. 12 MB
TracKasuwa_ANDROID_FILE_SIZE=
TracKasuwa_WINDOWS_FILE_SIZE=
# Disabled until medical workflow acceptance checks and device onboarding pass.
MEDICAL_STOCK_PILOT_ENABLED=false
# Stock intake stays disabled until the documented release gates pass.
NEXT_PUBLIC_STOCK_INTAKE_BATCHES_ENABLED=false
STOCK_INTAKE_WORKER_ENABLED=false
