# Required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0

# Zainpay — use test credentials locally; use live credentials only in
# the production environment. Credentials prefixed by the selected mode
# are isolated from the other mode. Legacy unprefixed credentials are
# supported when no mode-prefixed credentials are configured.
ZAINPAY_MODE=test
ZAINPAY_TEST_BASE_URL=https://sandbox.zainpay.ng
ZAINPAY_LIVE_BASE_URL=https://api.zainpay.ng
ZAINPAY_TEST_PUBLIC_KEY=
ZAINPAY_TEST_PRIVATE_KEY=
ZAINPAY_TEST_DEFAULT_ZAINBOX=
ZAINPAY_TEST_WEBHOOK_SECRET=
ZAINPAY_TEST_SECRET_KEY=
ZAINPAY_TEST_ZAINBOX_CODE=
ZAINPAY_LIVE_PUBLIC_KEY=
ZAINPAY_LIVE_PRIVATE_KEY=
ZAINPAY_LIVE_DEFAULT_ZAINBOX=
ZAINPAY_LIVE_WEBHOOK_SECRET=
ZAINPAY_LIVE_SECRET_KEY=
ZAINPAY_LIVE_ZAINBOX_CODE=

# Legacy single-mode credentials (used only when no mode-prefixed
# credentials are configured). Keep these matched to ZAINPAY_MODE.
ZAINPAY_PUBLIC_KEY=
ZAINPAY_PRIVATE_KEY=
ZAINPAY_BASE_URL=https://sandbox.zainpay.ng
ZAINPAY_DEFAULT_ZAINBOX=
ZAINPAY_WEBHOOK_SECRET=
ZAINPAY_SECRET_KEY=
ZAINPAY_ZAINBOX_CODE=

# Optional update metadata
TracKasuwa_WINDOWS_LATEST_VERSION=1.0.0
TracKasuwa_WINDOWS_DOWNLOAD_URL=
TracKasuwa_ANDROID_LATEST_VERSION=1.0.0
TracKasuwa_ANDROID_DOWNLOAD_URL=
TracKasuwa_ANDROID_UNKNOWN_SOURCES_HELP_URL=

# Optional debug
NODE_ENV=production

# Server-only AI plumbing (mock is the only implemented provider)
AI_PROVIDER=mock
AI_API_KEY=
AI_EMAIL_URL=
AI_EMAIL_KEY=
AI_SMS_URL=
AI_SMS_KEY=
